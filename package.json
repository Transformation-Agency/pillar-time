{
  "name": "pillar-time",
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings node server/index.js",
    "start": "NODE_ENV=production NODE_OPTIONS=--no-warnings node server/index.js",
    "tauri": "tauri",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:local": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && node scripts/sign-local-macos-app.mjs",
    "desktop:prepare": "node scripts/assert-node-runtime.mjs && npm run build && node scripts/prepare-tauri-sidecar.mjs",
    "build": "vite build",
    "check": "npm run build",
    "test": "node --test tests/*.test.js",
    "updater:validate": "node scripts/validate-updater-manifest.mjs",
    "promo:studio": "npm --prefix promo run studio",
    "promo:render": "npm --prefix promo run render"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "^6.0.2",
    "express": "^5.2.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
