{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pillar Time",
  "version": "0.2.1",
  "identifier": "com.pillartime.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "true",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pillar-time-backend", "binaries/whisper-cli"],
    "resources": ["resources/backend", "resources/whisper", "icons/tray-template.png", "icons/tray-template@1x.png"],
    "shortDescription": "Local-first time-management agent.",
    "longDescription": "Pillar Time combines daily planning, reminders, reviews, meetings, calendar context, and local intelligence workflows in a private desktop app.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 760,
          "height": 420
        },
        "appPosition": {
          "x": 210,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 550,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4QTRCMTRCRUJEMDhBQkEKUldTNml0RHJTN0drZUlxWXpFZDVhQlBxZFB6aUNISExDSk5JTk9nRXA4ci9VQVJ2SkRlY3pIZVUK",
      "endpoints": [
        "https://github.com/Transformation-Agency/pillar-time/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
